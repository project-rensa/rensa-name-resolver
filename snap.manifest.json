{
  "version": "0.1.0",
  "description": "Resolve .rns names and primary names on Robinhood Chain using Rensa's read-only API.",
  "proposedName": "Rensa Name Resolver",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-rensa/rensa-name-resolver.git"
  },
  "source": {
    "shasum": "Irld4eEQpPWnUqtXgQIT/10gJKNhdMe/lHfHsxTqFxI=",
    "location": {
      "npm": {
        "filePath": "dist/bundle.js",
        "iconPath": "images/icon.svg",
        "packageName": "rensa-name-resolver",
        "registry": "https://registry.npmjs.org/"
      }
    }
  },
  "initialPermissions": {
    "endowment:name-lookup": {
      "chains": ["eip155:4663"],
      "matchers": {
        "tlds": ["rns"]
      }
    },
    "endowment:network-access": {}
  },
  "platformVersion": "12.0.1",
  "manifestVersion": "0.1"
}
